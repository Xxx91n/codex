# .gitattributes — repo-root line-ending + binary policy
#
# Source of truth: crlf_lf_repository_policy (global AGENTS.md).
#
# Rules (in order of precedence — later rules override earlier):
# 1. Default: every text file is LF in repo, LF in working tree.
# 2. Windows-native scripts (.bat/.ps1/.cmd) keep CRLF in repo and on disk.
# 3. apply-patch test fixtures that intentionally preserve CRLF stay CRLF (do NOT normalize).
# 4. Binary files are marked binary — no newline normalization, no diffing.
# 5. Already-linguist-generated schemas keep that marker.

# --- 1. Default: text files → LF in repo and on disk ---
* text=auto eol=lf

# --- 2. Windows-native scripts → CRLF on disk ---
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# --- 3. Intentional-CRLF test fixtures (apply-patch preserves-CRLF scenarios) ---
codex-rs/apply-patch/tests/fixtures/scenarios/023_preserves_crlf_line_endings/** text eol=crlf

# --- 4. Binary allowlist (must precede the binary marker on each line) ---
*.png binary
*.jpg binary
